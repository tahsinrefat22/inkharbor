# Optional. An HTTPS page that forwards OAuth redirects to inkharbor://oauth,
# used only for Outline servers that don't accept custom-scheme redirect URIs
# yet (older than outline/outline#13945). Copy to .env.local to use.
# EXPO_PUBLIC_OAUTH_RELAY_URL=https://example.github.io/inkharbor/oauth

# Optional, development only: pre-fills the server address on the sign-in screen.
# EXPO_PUBLIC_DEFAULT_SERVER_URL=https://docs.example.com
